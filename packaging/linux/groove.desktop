[Desktop Entry]
Type=Application
Version=1.5
Name=Groove X
GenericName=Music Player
GenericName[vi]=Trình phát nhạc
Comment=Play and organize your music
Comment[vi]=Phát và sắp xếp nhạc của bạn
Exec=groove %F
Icon=groove
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;audio;player;mp3;flac;nhạc;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/mp4;audio/x-m4a;audio/x-m4r;audio/ogg;audio/x-vorbis+ogg;
StartupWMClass=groove
Actions=pip;

[Desktop Action pip]
Name=Picture in picture
Name[vi]=Trình phát thu nhỏ
Exec=groove --pip
