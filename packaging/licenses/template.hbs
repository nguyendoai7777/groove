<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Groovex: third-party licenses</title>
<style>
:root { color-scheme: light dark; --fg: #1c1c1c; --bg: #fff; --muted: #666; --line: #ddd; --code: #f5f5f5; }
@media (prefers-color-scheme: dark) { :root { --fg: #eee; --bg: #1c1c1c; --muted: #aaa; --line: #3a3a3a; --code: #262626; } }
body { margin: 0 auto; padding: 24px 16px; max-width: 900px; font: 15px/1.5 system-ui, sans-serif; color: var(--fg); background: var(--bg); }
h1 { font-size: 24px; } h2 { font-size: 18px; margin-top: 32px; } h3 { font-size: 15px; }
a { color: inherit; } .note, .used { color: var(--muted); }
article { border-top: 1px solid var(--line); margin-top: 24px; }
ul.used { padding-left: 20px; columns: 2; font-size: 13px; }
pre { background: var(--code); padding: 12px; overflow-x: auto; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12px; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p class="note">Groovex is built with the components below. / Groovex được dựng từ các thành phần dưới đây.</p>

<h2>Components outside the Rust dependency tree</h2>
<!-- extra-components -->

<h2>Rust crates, by license</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<article data-license="{{id}}">
<h3 id="{{id}}">{{name}}</h3>
<ul class="used">
{{#each used_by}}
<li data-crate="{{crate.name}}">{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</article>
{{/each}}
</body>
</html>
